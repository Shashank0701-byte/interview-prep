# Root .gitignore for interview-prep-ai

# Generated trained model artifacts (pickle files) at project root only
/models/
ai-training/study_buddy/models/trained/*.pkl
ai-training/study_buddy/models/trained/*.joblib
ai-training/study_buddy/data/processed/training_results_*.json
chroma_db/

# Environment files
.env
.env.local
.env.*.local

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code local state (worktrees, per-machine settings)
.claude/worktrees/
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db
nul

# Logs
*.log
